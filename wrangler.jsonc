// Cloudflare Workers settings for civicauditlens.org
// - site/ is served as the static website
// - src/worker.js handles POST /api/feedback (emails the feedback form to the owner)
{
  "name": "municipal-financial-risk-score",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // Email binding without a fixed address: the destination comes from the FEEDBACK_TO secret,
  // which must be a verified address in Email Routing (so the inbox is never in the public repo).
  "send_email": [
    { "name": "FEEDBACK_EMAIL" }
  ],
  "observability": { "enabled": true }
}
